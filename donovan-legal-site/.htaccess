RewriteEngine On 
RewriteCond %{SERVER_PORT} 80
RewriteCond %{HTTP_HOST} ^(www\.)?donovan\.law
RewriteRule ^(.*)$ https://www.donovan.law/$1 [R,L]

# Prevent caching of HTML and JS files (Donovan Legal — added May 2026)
<FilesMatch "\.(html|js)$">
  <IfModule mod_headers.c>
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </IfModule>
</FilesMatch>